# Secrets — never commit real values
.env

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Databases (real local data — a deployment should point DATABASE_URL at Postgres, not ship this file)
*.db
*.db-journal
*.sqlite
*.sqlite3

# Edge runtime data
edge/data/
edge/data/clips/
demo/videos/*.avi

# Calibration snapshot images (large, regenerable by re-running
# scripts/collect_calibration_data.py against the video) — the labeled
# manifest.json (the actual real result: D/T/S/H + manual labels) IS
# committed, since that's the non-regenerable part.
scripts/calibration_data/snapshots/
scripts/calibration_data_night/snapshots/
scripts/calibration_data_fog/snapshots/
scripts/calibration_data_glare/snapshots/
scripts/calibration_data_fog_mild/snapshots/
scripts/calibration_data_glare_mild/snapshots/
scripts/calibration_data_night_mild/snapshots/
scripts/calibration_data_night_fog/snapshots/
scripts/calibration_data_night_glare/snapshots/
scripts/calibration_data_night_fog_glare/snapshots/
scripts/calibration_data_fog_glare/snapshots/
scripts/calibration_data_night_fog_glare_mild/snapshots/
# MOT16 ground-truth calibration (scripts/collect_mot16_ground_truth_calibration.py)
# — same rationale, plus these snapshots are derived crops of CC BY-NC-SA
# licensed MOT16 footage (Milan et al., https://motchallenge.net); not
# redistributing them keeps the repo clear of any redistribution question
# even though the license would likely permit it. manifest.json (numeric
# candidate data + bbox coordinates, no image bytes) IS committed.
scripts/calibration_data_mot16_04/snapshots/
scripts/calibration_data_mot16_02/snapshots/

# Frontend
frontend/node_modules/
frontend/dist/

# TLS material
certs/*.key
certs/*.crt
certs/*/*.key
certs/*/*.crt
certs/edge/*.aes
certs/edge/*.pem

# OS / editor / logs
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Machine-local dev-preview config (hardcoded local paths/python.exe location,
# not portable — see docs/LIMITATIONS.md)
.claude/

# Temporary / Scratch Outputs
scratch/
out*.txt
docs/benchmark_raw*.json
docs/*_demo.json
docs/*_vtest.json
node_modules
