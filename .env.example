# =============================================================================
# NETRAKSH: Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file:    cp .env.example .env
#   2. Fill in all values marked REQUIRED (production will fail to start otherwise)
#   3. NEVER commit the actual .env file — it is gitignored
#   4. To generate a secure random key:  python -c "import secrets; print(secrets.token_hex(32))"
#      or:                               openssl rand -hex 32
#
# MANDATORY IN PRODUCTION (startup will refuse to run with these missing or weak):
#   DATABASE_URL
#   SECRET_KEY         (must NOT start with "CHANGE_ME")
#   ADMIN_PASSWORD     (must NOT be "admin")
#   INITIAL_OPERATOR_PASSWORD   (must NOT be "operator")
#   INITIAL_AUDITOR_PASSWORD    (must NOT be "auditor")
# =============================================================================


# =============================================================================
# ENVIRONMENT MODE
# =============================================================================
# Controls startup validation strictness.
# "production"  — fails fast if unsafe defaults are detected
# "development" — lenient defaults allowed for local dev
ENV=development


# =============================================================================
# DATABASE
# =============================================================================
# REQUIRED in production. Format: postgresql://<user>:<password>@<host>:<port>/<db>
# For Render deployment: set this in the Render dashboard → Environment tab only.
# NEVER hardcode credentials here in a committed file.
# Local development: point to your local PostgreSQL instance.
DATABASE_URL=postgresql://netraksh_user:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/netraksh_dev


# =============================================================================
# SECURITY — JWT SIGNING
# =============================================================================
# REQUIRED in production. Must be at least 32 hex characters (256 bits).
# Generate:  openssl rand -hex 32
# WARNING:   The default value (CHANGE_ME_*) causes production startup to FAIL.
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32

# Required in production unless MTLS_MODE=required. Set the same high-entropy
# value on approved edge devices; never expose it to Vite.
EDGE_AUTH_TOKEN=REPLACE_WITH_A_32_CHARACTER_OR_LONGER_EDGE_SECRET

# JWT algorithm — do not change unless you know the implications
ALGORITHM=HS256

# Token lifetime in minutes (default: 8 hours = 480 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480


# =============================================================================
# RBAC — INITIAL USER CREDENTIALS
# =============================================================================
# REQUIRED in production. Weak defaults (admin/operator/auditor) cause FAIL.
# After first boot, change these via the admin UI or directly in the DB.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(20))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

INITIAL_OPERATOR_USERNAME=operator
INITIAL_OPERATOR_PASSWORD=REPLACE_WITH_STRONG_OPERATOR_PASSWORD

INITIAL_AUDITOR_USERNAME=auditor
INITIAL_AUDITOR_PASSWORD=REPLACE_WITH_STRONG_AUDITOR_PASSWORD



# Where evidence images are stored on this machine.
# Edge: the local clips directory. Backend: must match or use object storage.
EVIDENCE_CLIPS_DIR=edge/data/clips

# Storage backend: "local" (default) or "object" (future S3/GCS)
EVIDENCE_STORAGE_BACKEND=local


# =============================================================================
# COMMAND IDENTITY
# =============================================================================
# Unique identifier for this command center instance.
COMMAND_ID=COMMAND_A


# =============================================================================
# BLOCKCHAIN
# =============================================================================
# "mock" — local in-memory mock (clearly labelled in UI and API)
# "fabric" — real Hyperledger Fabric (requires WSL2/Docker + chaincode deployed)
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_MOCK_LABEL=BLOCKCHAIN: MOCK MODE (Fabric not available — see docs/ARCHITECTURE.md)


# =============================================================================
# CORS / FRONTEND ORIGINS
# =============================================================================
# Comma-separated list of allowed frontend origins.
# Wildcard '*' is prohibited and will cause startup failure.
# Development: leave empty or use localhost values.
# Production: set to the actual Vercel/CDN frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173


# =============================================================================
# VIDEO / EDGE
# =============================================================================
# Source for the edge pipeline:
#   "0"           — webcam
#   "sample_video" — first .mp4/.avi found in demo/videos/
#   "<path>"      — specific file
#   "rtsp://..."  — RTSP stream URL
VIDEO_SOURCE=sample_video
EDGE_DEVICE_ID=edge-dev-01

# Simulate frozen camera for testing (set "true" to activate)
SIMULATE_FROZEN_CAMERA=false
# Simulate night conditions for testing (set "true" to activate)
SIMULATE_NIGHT_CONDITION=false


# =============================================================================
# RELIABILITY ENGINE (optional overrides)
# =============================================================================
# Weights for the hybrid reliability score (D+T+S+H must sum to 1.0)
# Leave commented out to use the calibrated defaults.
# RELIABILITY_WEIGHT_D=0.40
# RELIABILITY_WEIGHT_T=0.20
# RELIABILITY_WEIGHT_S=0.20
# RELIABILITY_WEIGHT_H=0.20


# =============================================================================
# EXTERNAL INTEGRATIONS
# =============================================================================
# Webhook URL for external C2 systems (optional). Receives CRITICAL/SEVERE alerts.
ESCALATION_WEBHOOK_URL=https://hooks.example.com/YOUR_WEBHOOK_PATH


# =============================================================================
# SERVER
# =============================================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
DEBUG=false
LOG_LEVEL=INFO


# =============================================================================
# FRONTEND (Vite build-time variables)
# =============================================================================
# For local development with Vite dev server pointing at local backend:
VITE_BACKEND_URL=http://localhost:8443
VITE_WS_URL=ws://localhost:8443/ws/dashboard
# For production Vercel → Render deployment:
# VITE_BACKEND_URL=https://netraksh.onrender.com
# VITE_WS_URL=wss://netraksh.onrender.com/ws/dashboard
