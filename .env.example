# NETRAKSH — Environment Configuration
# Copy this to .env and fill in real values. NEVER commit .env to version control.

# --- Edge identity ---
EDGE_DEVICE_ID=edge-001
EDGE_PRIVATE_KEY_PATH=certs/edge/edge-001.key
EDGE_CERT_PATH=certs/edge/edge-001.crt
CA_CERT_PATH=certs/ca/ca.crt

# --- Video source ---
# Set to a local video file path, rtsp://..., or "webcam" (index 0)
VIDEO_SOURCE=demo/videos/sample_cctv.mp4
# Set to true to freeze frame delivery for camera-failure demo
SIMULATE_FROZEN_CAMERA=false
# Set to true to overlay dark filter for night demo
SIMULATE_NIGHT_CONDITION=false

# --- Offline / sync simulation ---
SIMULATE_OFFLINE=false
BACKEND_URL=https://localhost:8443
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_SECONDS=30

# --- Edge SQLite paths ---
EDGE_DB_PATH=edge/data/edge.db
EVIDENCE_CHAIN_DB_PATH=edge/data/chain.db

# --- Server ---
SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
DATABASE_URL=postgresql://netraksh:netraksh_password@localhost:5432/netraksh
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
ENV=development
# CORS_ORIGINS supports a comma-separated list of fully qualified domains.
CORS_ORIGINS=https://command-center.yourdomain.com

# --- mTLS ---
TLS_ENABLED=true
SERVER_CERT_PATH=certs/server/server.crt
SERVER_KEY_PATH=certs/server/server.key

# --- RBAC defaults ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
INITIAL_OPERATOR_USERNAME=operator
INITIAL_OPERATOR_PASSWORD=operator

# --- Reliability / detection thresholds (prototype — explicitly labelled as such) ---
# These are prototype values, NOT scientifically calibrated thresholds.
# Replace with isotonic/Platt calibration outputs before production use.
THRESHOLD_CLEAR_DAY=0.45
THRESHOLD_LOW_LIGHT_NIGHT=0.30
THRESHOLD_FOG_RAIN=0.35
THRESHOLD_GLARE=0.40

# --- Zones config (JSON file path) ---
ZONES_CONFIG_PATH=demo/scripts/zones_config.json

# --- Demo / blockchain ---
# "mock" uses PostgreSQL-backed mock adapter (clearly labelled in UI)
# "fabric" uses real Hyperledger Fabric via peer CLI
BLOCKCHAIN_MODE=mock
BLOCKCHAIN_MOCK_LABEL=BLOCKCHAIN: MOCK MODE (Fabric not available on this host)
# Fabric peer CLI path (only used when BLOCKCHAIN_MODE=fabric)
FABRIC_PEER_BIN=peer
FABRIC_CHANNEL=netraksh-channel
FABRIC_CHAINCODE=netraksh-cc
FABRIC_ORG_MSP=CommandAMSP

# --- Logging ---
LOG_LEVEL=INFO
AUDIT_LOG_ENABLED=true

# --- Frontend ---
VITE_API_BASE_URL=https://localhost:8443
VITE_WS_URL=wss://localhost:8443/ws/alerts
